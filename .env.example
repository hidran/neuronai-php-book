# Copy to .env and fill in whichever provider you intend to use.
#
# Every example in this repository runs against Ollama with no API key at all.
# The cloud providers are optional: set a key only for the provider you want.

# ---------------------------------------------------------------------------
# Local, free, no account required. This is the default the examples use.
# ---------------------------------------------------------------------------
NEURON_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Optional cloud providers.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ---------------------------------------------------------------------------
# Observability (Chapter 16). Optional.
# ---------------------------------------------------------------------------
INSPECTOR_INGESTION_KEY=
