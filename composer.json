{
    "name": "hidran/neuronai-php-book",
    "description": "Runnable code examples from the book \"Agentic AI in PHP with NeuronAI\" by Hidran Arias.",
    "type": "project",
    "license": "MIT",
    "keywords": ["ai", "agents", "neuron-ai", "php", "laravel", "rag", "llm"],
    "authors": [
        {
            "name": "Hidran Arias"
        }
    ],
    "require": {
        "php": "^8.2",
        "neuron-core/neuron-ai": "4.x-dev as 4.0.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "livewire/livewire": "^3.5",
        "neuron-core/neuron-laravel": "2.x-dev",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "NeuronBook\\": "chapters/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronBook\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "lint": "find chapters tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null && echo 'php -l: all files parse'",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "smoke": "./smoke.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
